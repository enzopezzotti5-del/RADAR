# Runtime Flask do Radar.
RADAR_V2_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
RADAR_V2_SESSION_COOKIE_SECURE=false
RADAR_V2_SESSION_HOURS=8
RADAR_V2_SCHEDULER_ENABLED=true

# Frontend React integrado ao mesmo servidor Flask.
VITE_RADAR_DATA_SOURCE=flask
VITE_RADAR_READ_ONLY=false
VITE_RADAR_API_BASE=/api
VITE_RADAR_PROXY_TARGET=http://127.0.0.1:5000

# Paths locais opcionais para integrações legadas.
ENERGIA_SECRET_KEY_FILE=
COPEL_ACCESSOS_XLS_PATH=

# Integrações operacionais opcionais. Nunca informe valores reais neste arquivo.
CONSEN_USUARIO=
CONSEN_SENHA=
ENERGISA_IMAP_HOST=
ENERGISA_IMAP_PORT=993
ENERGISA_IMAP_USER=
ENERGISA_IMAP_PASS=
EMAIL_REMETENTE=
EMAIL_SENHA=
TWOCAPTCHA_API_KEY=
